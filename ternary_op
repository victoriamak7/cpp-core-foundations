#include <iostream>

int main(){
    //ternary operator ? : = is a replacement to an if/else statement
    //condition ? exp1 : exp2;

    int grade = 75;

    grade >= 60 ? std::cout<<"u pass!!!!!!!!" : std::cout<<"u fail :/";
    
    int number = 9;
    number % 2 == 1 ? std::cout<<"odd" : std::cout<<"even";

    return 0;
}
