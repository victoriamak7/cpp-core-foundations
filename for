#include <iostream>

int main(){
    //for - a loop that will execute a block of code
    //a specified amount of times

    for(int i = 1; i <= 10; i++ ){
        std::cout<<i<<'\n';
    }
    std::cout<<"happy new year\n";

    for(int z = 0; z < 9; z+=2){
        std::cout<<"yipee"<<'\n';
    }

    return 0;
}
