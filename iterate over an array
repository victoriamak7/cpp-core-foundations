#include <iostream>

int main(){
    std::string students[] = {"sponge", "pat", "squid"};
    char grades[] = {'A', 'B', 'C', 'D', 'F'};

    for(int i = 0; i < sizeof(students)/sizeof(std::string); i++){
        std::cout<<students[i]<<'\n';
    }

    for(int j = 0; j < sizeof(grades)/sizeof(char); i++){
        std::cout<<grades[j]<<'\n';
    }
}
